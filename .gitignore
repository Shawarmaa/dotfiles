.DS_Store

# Machine-local overrides, never tracked (see zsh/.zshrc, git/.gitconfig).
*.local

# Vendored agent skills. Declared in skills.json, installed by
# scripts/skills-sync.sh — the manifest is the source of truth, not the files.
# Hand-written skills are excepted below and stay tracked.
agents/.agents/skills/*
!agents/.agents/skills/summarize/

# Runtime state these apps write next to their config. install.sh stows with
# --no-folding so it should land on the machine, not here — these are a net.
# One link per skill into agents/, regenerated by install.sh's mirror_skills so
# ~/.claude/skills stays a real directory that our skills and yours can share.
claude/.claude/skills/

herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
ghostty/Library/Application Support/com.mitchellh.ghostty/auto/
